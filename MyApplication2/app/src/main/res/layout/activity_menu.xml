<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Menu">

    <View
        android:id="@+id/fondo"
        android:layout_width="407dp"
        android:layout_height="894dp"
        android:background="#ffff"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <View
        android:id="@+id/cuadradoDecorativo"
        android:layout_width="440dp"
        android:layout_height="143dp"
        android:background="#FF5722"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hola,admin"
        android:textColor="#ffff"
        android:textSize="30sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.062"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.023" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Acrilinco"
        android:textColor="#ffff"
        android:textSize="50sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.073"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.091" />

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="93dp"
        android:layout_height="104dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.871"
        app:layout_constraintStart_toStartOf="@+id/cuadradoDecorativo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.039"
        app:srcCompat="@drawable/user__1_" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Menú principal"
        android:textColor="#A6A6A6"
        android:textSize="35sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.088"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.252" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardInventario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_card_inventario"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <!-- Cuadrado naranja decorativo -->
        <View
            android:id="@+id/iconoInventario"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_icono_naranja"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Título -->
        <TextView
            android:id="@+id/tituloInventario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Inventario"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/flechaInventario"
            app:layout_constraintStart_toEndOf="@id/iconoInventario"
            app:layout_constraintTop_toTopOf="@id/iconoInventario" />

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/subtituloInventario"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pinturas, stock y productos"
            android:textColor="#888888"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@id/iconoInventario"
            app:layout_constraintEnd_toStartOf="@id/flechaInventario"
            app:layout_constraintStart_toStartOf="@id/tituloInventario"
            app:layout_constraintTop_toBottomOf="@id/tituloInventario" />

        <!-- Flecha -->
        <ImageView
            android:id="@+id/flechaInventario"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/chevron_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#000000" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardFinanzas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_card_inventario"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.584">

        <!-- Cuadrado negro con ícono -->
        <View
            android:id="@+id/iconoFinanzasFondo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_icono_negro"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Ícono de edificio encima del cuadrado negro -->
        <ImageView
            android:id="@+id/iconoFinanzas"
            android:layout_width="28dp"
            android:layout_height="28dp"
            app:layout_constraintBottom_toBottomOf="@id/iconoFinanzasFondo"
            app:layout_constraintEnd_toEndOf="@id/iconoFinanzasFondo"
            app:layout_constraintStart_toStartOf="@id/iconoFinanzasFondo"
            app:layout_constraintTop_toTopOf="@id/iconoFinanzasFondo"
            app:tint="#FFFFFF" />

        <!-- Título -->
        <TextView
            android:id="@+id/tituloFinanzas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Finanzas"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/flechaFinanzas"
            app:layout_constraintStart_toEndOf="@id/iconoFinanzasFondo"
            app:layout_constraintTop_toTopOf="@id/iconoFinanzasFondo" />

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/subtituloFinanzas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ingresos, gastos y balance"
            android:textColor="#888888"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@id/iconoFinanzasFondo"
            app:layout_constraintEnd_toStartOf="@id/flechaFinanzas"
            app:layout_constraintStart_toStartOf="@id/tituloFinanzas"
            app:layout_constraintTop_toBottomOf="@id/tituloFinanzas" />

        <!-- Flecha -->
        <ImageView
            android:id="@+id/flechaFinanzas"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/chevron_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#000000" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- TARJETA CLIENTES (reemplaza el bloque duplicado de cardFinanzas) -->

    <!-- BOTON CERRAR SESION -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardClientes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_card_inventario"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackground"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.762">

        <!-- Cuadrado gris con ícono -->
        <View
            android:id="@+id/iconoClientesFondo"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_icono_gris"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Ícono de personas -->
        <ImageView
            android:id="@+id/iconoClientes"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_people"
            app:layout_constraintBottom_toBottomOf="@id/iconoClientesFondo"
            app:layout_constraintEnd_toEndOf="@id/iconoClientesFondo"
            app:layout_constraintStart_toStartOf="@id/iconoClientesFondo"
            app:layout_constraintTop_toTopOf="@id/iconoClientesFondo"
            app:tint="#888888" />

        <!-- Título -->
        <TextView
            android:id="@+id/tituloClientes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Clientes"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/flechaClientes"
            app:layout_constraintStart_toEndOf="@id/iconoClientesFondo"
            app:layout_constraintTop_toTopOf="@id/iconoClientesFondo" />

        <!-- Subtítulo -->
        <TextView
            android:id="@+id/subtituloClientes"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Proximamente"
            android:textColor="#888888"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@id/iconoClientesFondo"
            app:layout_constraintEnd_toStartOf="@id/flechaClientes"
            app:layout_constraintStart_toStartOf="@id/tituloClientes"
            app:layout_constraintTop_toBottomOf="@id/tituloClientes" />

        <!-- Flecha -->
        <ImageView
            android:id="@+id/flechaClientes"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/chevron_right"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#000000" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/btnCerrarSesion"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:text="Cerrar sesión"
        android:textAllCaps="false"
        android:textColor="#FF6B1A"
        android:textStyle="bold"
        android:backgroundTint="@android:color/white"
        app:icon="@android:drawable/ic_menu_revert"
        app:iconTint="#FF6B1A"
        app:strokeColor="#FF6B1A"
        app:strokeWidth="2dp"
        app:cornerRadius="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>