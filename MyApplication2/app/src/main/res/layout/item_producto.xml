<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="12dp">

        <View
            android:id="@+id/vColorProducto"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#FF5722"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvNombreProducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Vinilo Tipo 1 - Blanco"
            android:textColor="#212121"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvCantidadProducto"
            app:layout_constraintStart_toEndOf="@id/vColorProducto"
            app:layout_constraintTop_toTopOf="@id/vColorProducto" />

        <TextView
            android:id="@+id/tvDetalleProducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:text="Galón - $58.000"
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/tvCantidadProducto"
            app:layout_constraintStart_toEndOf="@id/vColorProducto"
            app:layout_constraintTop_toBottomOf="@id/tvNombreProducto" />

        <TextView
            android:id="@+id/tvCantidadProducto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18 und"
            android:textColor="#212121"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/vColorProducto" />

        <TextView
            android:id="@+id/tvEstadoProducto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Disponible"
            android:textColor="#4CAF50"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCantidadProducto" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>